# Copia a .env y completa. NO commitear .env real.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_SCHEMA=sst
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4001
PUBLIC_APP_URL=http://localhost:4001
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_NOMBRE=Administrador JD&D
ADMIN_EMAIL=admin@jdd.com
ADMIN_DOCUMENTO=1234567890
ADMIN_PASSWORD=
# STORAGE_DRIVER: local (default, escribe en ./storage) | s3 (nube)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3 (solo si STORAGE_DRIVER=s3). Credenciales leídas por el SDK de AWS_*.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: endpoint para S3-compatible (DigitalOcean Spaces / Linode).
S3_ENDPOINT=
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JD&D Consultores <no-reply@jdd.com>
# === IA · MOTOR PRINCIPAL de extracción de OS (M2) = OpenAI ===
# OpenAIExtractionService (gpt-4o-mini) es el motor principal de extracción de PDF.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=4096

# === IA · AUXILIAR (PENDIENTE DE MIGRACIÓN a OpenAI) = Gemini ===
# NO es el motor de extracción. Solo alimenta clasificación de ARL, resumen
# ejecutivo y búsqueda en lenguaje natural. Si se deja vacío, esas funciones
# caen a un mock realista.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
